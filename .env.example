# ──────────────────────────────────────────────────────────────────────────────
# Deepgram API key  (server-side only — never exposed to the browser)
# ──────────────────────────────────────────────────────────────────────────────
# 1. Sign up for a free account at https://console.deepgram.com
# 2. Create an API key (Projects → API Keys → Create Key)
# 3. Copy this file to .env  →  cp .env.example .env
# 4. Paste your key below (replace "your_key_here")
#
# The Vite dev server reads this key at startup and injects it into every
# proxied request to Deepgram — it is NEVER included in the browser bundle.
#
# ⚠️  Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_key_here

# ──────────────────────────────────────────────────────────────────────────────
# Anthropic API key  (browser-visible via VITE_ prefix)
# ──────────────────────────────────────────────────────────────────────────────
# Used by the LLM fallback in parseVoiceCommand() when the local regex grammar
# cannot parse a transcript.  The fallback calls Claude (claude-haiku-4-5) via
# tool use and adds ~200–400 ms to the pipeline for unrecognised phrases.
#
# If this key is absent the local grammar still works for all common commands;
# unusual phrasings will surface a PARSE_FAILURE toast instead of crashing.
#
# 1. Go to https://console.anthropic.com/settings/keys
# 2. Create a key and paste it below.
#
# ⚠️  This key IS bundled into the client JS (VITE_ prefix).
#     Use a restricted key with a spending limit for public deployments.
# ──────────────────────────────────────────────────────────────────────────────
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here
